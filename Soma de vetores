#include <stdio.h>
#include <stdlib.h>

    void Somatoria(){

    int elementos, i;
    int soma = 0;

    printf("Digite o numero de elementos do vetor que deseja gerar a somatoria: ");
    scanf("%d", &elementos);

    int vetor[elementos];

    for(i = 0; i<elementos; i++){
        printf("Digite o %d elemento: ", i+1);
        scanf("%d", &vetor[i]);
        soma = soma + vetor[i];
    
}
    printf("Somatoria e: %d", soma);
    
}
			int main()
	{
	
		Somatoria();
	
      return 0;
}
